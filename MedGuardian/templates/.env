# .env

# Flask App Secret Key (if using sessions)
SECRET_KEY=your_flask_secret_key

# NewsAPI Key (optional)
NEWS_API_KEY=your_newsapi_key_here

# Email Alert Credentials (optional)
EMAIL_SENDER_ADDRESS=your_email@example.com
EMAIL_SENDER_PASSWORD=your_email_password

# Twilio or SMS API (optional)
SMS_API_KEY=your_sms_api_key_here
EMAIL_SENDER_ADDRESS=youremail@gmail.com
EMAIL_SENDER_PASSWORD=your_app_password_here
